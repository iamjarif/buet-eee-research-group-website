# =============================================================================
# NC Group Website — Environment Variables
# =============================================================================
# Copy this file to `.env.local` and fill in your values.
# Never commit `.env.local` or any file containing secrets.
# =============================================================================

# --- Public Sanity configuration (safe for client-side use) ---
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=

# --- Server-only Sanity configuration ---
# Read token for draft/preview mode and server-side fetches with elevated access.
# Create at: https://www.sanity.io/manage → Project → API → Tokens
SANITY_API_READ_TOKEN=

# Write token for local content seeding scripts only (Editor permissions).
# Used by: npm run seed:homepage:apply
# Never expose this to the browser or prefix with NEXT_PUBLIC_.
SANITY_API_WRITE_TOKEN=

# Secret used to authenticate Sanity webhook revalidation requests.
# Send as header x-revalidate-secret (or Authorization: Bearer) on POST /api/revalidate.
# Do not put this secret in the webhook URL query string.
SANITY_REVALIDATE_SECRET=

# Deploy token for `npm run setup:webhook` (sanity.io/manage → API → Tokens).
# Needs webhook read/write grants; Editor tokens often lack this permission.
SANITY_DEPLOY_TOKEN=

# Shared secret for POST /api/sync/publications (Authorization: Bearer or x-sync-secret).
SYNC_SECRET=

# Vercel Cron secret for GET /api/sync/publications.
# When set in Vercel project settings, scheduled cron requests include
# Authorization: Bearer CRON_SECRET. Not a replacement for SYNC_SECRET.
CRON_SECRET=

# --- Site configuration ---
# Canonical base URL for SEO (sitemap, Open Graph, canonical links).
NEXT_PUBLIC_SITE_URL=

# --- Contact form (Resend) ---
# Create an API key at https://resend.com/api-keys
RESEND_API_KEY=

# Verified sender address in Resend (must match a verified domain in Resend)
CONTACT_FORM_FROM_EMAIL=

# Recipient inbox. Falls back to contactEmail in Sanity Site Settings when unset.
CONTACT_FORM_TO_EMAIL=

# --- Team application CV uploads (Vercel Blob) ---
# Create a read/write token at https://vercel.com/docs/storage/vercel-blob
BLOB_READ_WRITE_TOKEN=

# HMAC secret for signed CV download links (/api/applications/[id]/cv).
# Required. Never reuse SANITY_REVALIDATE_SECRET or any other shared secret.
# Generate with: openssl rand -hex 32
APPLICATIONS_CV_SIGNING_SECRET=

# Optional Bearer token for admin CV downloads without a signed URL.
APPLICATIONS_CV_ADMIN_SECRET=

# --- Rate limiting (Upstash Redis via Vercel Storage) ---
# Used by POST /api/contact (3 submissions per 10 minutes per IP).
# Vercel injects these when you connect an Upstash Redis store.
KV_REST_API_READ_ONLY_TOKEN=
KV_REST_API_TOKEN=
KV_REST_API_URL=
KV_URL=
REDIS_URL=