# =============================================================================
# S-DREAM Website — Environment Variables
# =============================================================================
# Copy this file to `.env.local` and fill in your values.
# Never commit `.env.local` or any file containing secrets.
# =============================================================================

# --- Public Sanity configuration (safe for client-side use) ---
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-08-13

# --- Server-only Sanity configuration ---
# Read token for draft/preview mode and server-side fetches with elevated access.
# Create at: https://www.sanity.io/manage → Project → API → Tokens
SANITY_API_READ_TOKEN=

# Write token for local content seeding scripts only (Editor permissions).
# Used by: npm run seed:homepage:apply
# Never expose this to the browser or prefix with NEXT_PUBLIC_.
SANITY_API_WRITE_TOKEN=

# Secret used to authenticate Sanity webhook revalidation requests.
# Generate a random string and configure it in your Sanity webhook URL:
# https://your-domain.com/api/revalidate?secret=YOUR_SECRET
SANITY_REVALIDATE_SECRET=

# --- Site configuration ---
# Canonical base URL for SEO (sitemap, Open Graph, canonical links).
# Example: https://sdream.buet.ac.bd
NEXT_PUBLIC_SITE_URL=http://localhost:3000
