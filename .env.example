# =============================================================================
# NC Group Website — Environment Variables
# =============================================================================
# Copy this file to `.env.local` and fill in your values.
# Never commit `.env.local` or any file containing secrets.
# =============================================================================

# --- Public Sanity configuration (safe for client-side use) ---
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=

# --- Server-only Sanity configuration ---
# Read token for draft/preview mode and server-side fetches with elevated access.
# Create at: https://www.sanity.io/manage → Project → API → Tokens
SANITY_API_READ_TOKEN=

# Write token for local content seeding scripts only (Editor permissions).
# Used by: npm run seed:homepage:apply
# Never expose this to the browser or prefix with NEXT_PUBLIC_.
SANITY_API_WRITE_TOKEN=

# Secret used to authenticate Sanity webhook revalidation requests.
# Generate a random string and configure it in your Sanity webhook URL:
# https://your-domain.com/api/revalidate?secret=YOUR_SECRET
SANITY_REVALIDATE_SECRET=

# Shared secret for POST /api/sync/publications (Authorization: Bearer or x-sync-secret).
SYNC_SECRET=

# Vercel Cron secret for GET /api/sync/publications.
# When set in Vercel project settings, scheduled cron requests include
# Authorization: Bearer CRON_SECRET. Not a replacement for SYNC_SECRET.
CRON_SECRET=

# --- Site configuration ---
# Canonical base URL for SEO (sitemap, Open Graph, canonical links).
NEXT_PUBLIC_SITE_URL=

# --- Contact form (Resend) ---
# Create an API key at https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key

# Verified sender address in Resend (must match a verified domain in Resend)
CONTACT_FORM_FROM_EMAIL="NC Group <contact@yourdomain.com>"

# Recipient inbox. Falls back to contactEmail in Sanity Site Settings when unset.
CONTACT_FORM_TO_EMAIL=
